# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=your-production-db-host.railway.app
DB_USER=root
DB_PASS=your-secure-database-password
DB_NAME=affirmation_db
DB_PORT=3306

# Frontend Configuration (for CORS)
FRONTEND_URL=https://your-frontend-domain.netlify.app

# JWT Configuration (Optional - for future authentication)
JWT_SECRET=change-this-to-a-random-secure-string-min-32-chars

# Chrome/Puppeteer Configuration
CHROME_PATH=/usr/bin/google-chrome-stable

# Optional: Admin Notifications
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PHONE=+91XXXXXXXXXX

# Optional: Logging
LOG_LEVEL=info
