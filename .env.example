# ========================================================
# 🚀 RAILWAY PRODUCTION ENVIRONMENT VARIABLES SCHEME
# ========================================================

# 🌐 Server Configuration
PORT=5000
NODE_ENV=production

# 🍃 MongoDB Session Persistence (RemoteAuth for whatsapp-web.js)
# Required to keep WhatsApp sessions persistent across Railway restarts
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/whatsapp_sessions?retryWrites=true&w=majority

# 🗄️ MySQL / PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=inner_reset_db

# 🔑 Authentication & Tokens
JWT_SECRET=super_secret_jwt_key_inner_reset_2026

# 🤖 Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# 💳 Razorpay / PhonePe Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 🐧 Puppeteer / Chrome Railway Configuration
# Configured automatically by nixpacks.toml or Railway environment
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_PATH=/usr/bin/chromium
